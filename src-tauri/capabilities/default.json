{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for BetterJungler main desktop companion window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "global-shortcut:default",
    "allow-get-app-state",
    "allow-set-overlay-mode",
    "allow-get-settings",
    "allow-save-settings",
    "allow-save-riot-api-key",
    "allow-sync-ddragon",
    "allow-fetch-summoner-profile",
    "allow-get-lcu-profile",
    "allow-apply-runes-and-spells",
    "allow-sync-recent-matches",
    "allow-get-cached-matches",
    "allow-get-climb-goals",
    "allow-upsert-climb-goal",
    "allow-delete-climb-goal",
    "allow-set-focus-goal",
    "allow-refresh-high-elo-meta",
    "allow-get-cached-meta-snapshot",
    "allow-save-ai-api-key",
    "allow-generate-ai-debrief",
    "allow-update-overlay-preferences",
    "allow-get-lp-history",
    "allow-check-riot-api-key-health",
    "allow-get-app-meta",
    "allow-open-logs-folder",
    "allow-check-update",
    "allow-install-update",
    "allow-stage-update",
    "allow-probe-hardware-encoder",
    "allow-get-recording-status",
    "allow-list-recordings",
    "allow-get-match-recording",
    "allow-toggle-recording-pin",
    "allow-delete-recording",
    "allow-save-recording-clip",
    "allow-delete-recording-clip",
    "allow-open-recordings-folder",
    "allow-get-personal-learning-snapshot",
    "allow-inspect-replay-config",
    "allow-set-replay-api-enabled",
    "allow-seek-riot-replay"
  ]
}
